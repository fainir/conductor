{
  "name": "@fainir/conductor",
  "version": "0.4.1",
  "description": "Verified, deterministic tool calls for Claude Code: an MCP server (and Claude Code plugin) whose tools run through verify + retry + fallback over hermetic claude calls.",
  "keywords": [
    "claude-code",
    "claude",
    "mcp",
    "mcp-server",
    "claude-code-plugin",
    "verification",
    "reliability",
    "llm",
    "tools"
  ],
  "type": "module",
  "license": "MIT",
  "author": "fainir",
  "homepage": "https://github.com/fainir/conductor#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/fainir/conductor.git"
  },
  "bugs": {
    "url": "https://github.com/fainir/conductor/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "conductor-mcp": "dist/conductor-mcp.cjs"
  },
  "files": [
    "dist",
    "src",
    "commands",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "solve": "tsx src/cli.ts",
    "mcp": "tsx src/mcp.ts",
    "eval": "tsx eval/run-eval.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "build": "esbuild src/mcp.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/conductor-mcp.cjs --banner:js=\"#!/usr/bin/env node\"",
    "release": "node scripts/release.mjs",
    "scores": "tsx src/scores.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.22.4",
    "typescript": "^5.6.0"
  }
}
